<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- AJUSTE POR AMBIENTE: aponte para a mesma instância SQL do AXMonitor.
       O valor CHANGE_ME é inválido de propósito, para falhar de imediato
       caso este passo seja esquecido. -->
  <connectionStrings>
    <add name="ComunicadorDB"
         connectionString="Server=CHANGE_ME\CHANGE_ME;Database=Comunicador;Integrated Security=True;"
         providerName="System.Data.SqlClient" />
  </connectionStrings>

  <system.web>
    <compilation debug="false" targetFramework="4.5">
      <assemblies>
        <add assembly="System.Web.Extensions, Version=4.0.0.0, Culture=neutral, PublicKeyToken=31BF3856AD364E35" />
      </assemblies>
    </compilation>
    <!-- maxRequestLength (KB): folga acima do limite de 5 MB por arquivo aplicado na API -->
    <httpRuntime targetFramework="4.5" enableVersionHeader="false" maxRequestLength="7168" />
    <customErrors mode="RemoteOnly" />
    <!-- fileEncoding: os .aspx/.ashx/.cs estão em UTF-8. Sem esta linha, arquivos
         sem BOM são lidos como Windows-1252 e os acentos viram "Ã¡". -->
    <globalization culture="pt-BR" uiCulture="pt-BR" fileEncoding="utf-8" requestEncoding="utf-8" responseEncoding="utf-8" />

    <!-- Depois de configurar HTTPS no IIS, troque requireSSL para "true". -->
    <authentication mode="Forms">
      <forms loginUrl="~/Login.aspx" defaultUrl="~/Chat.aspx" name=".COMUNICADOR"
             timeout="600" slidingExpiration="true" requireSSL="false"
             protection="All" cookieless="UseCookies" />
    </authentication>
    <httpCookies httpOnlyCookies="true" />

    <!-- Tudo exige login, exceto as exceções em <location> abaixo -->
    <authorization>
      <deny users="?" />
    </authorization>
  </system.web>

  <location path="Login.aspx">
    <system.web><authorization><allow users="*" /></authorization></system.web>
  </location>
  <!-- A API faz a própria checagem de login e responde 401 em JSON
       (em vez de redirecionar para a página de login) -->
  <location path="Api.ashx">
    <system.web><authorization><allow users="*" /></authorization></system.web>
  </location>
  <location path="Setup.aspx">
    <system.web><authorization><allow users="*" /></authorization></system.web>
  </location>
  <location path="site.css">
    <system.web><authorization><allow users="*" /></authorization></system.web>
  </location>
  <location path="site.js">
    <system.web><authorization><allow users="*" /></authorization></system.web>
  </location>

  <system.webServer>
    <security>
      <requestFiltering>
        <!-- bytes; precisa acompanhar o maxRequestLength acima -->
        <requestLimits maxAllowedContentLength="7340032" />
      </requestFiltering>
    </security>
    <defaultDocument>
      <files><clear /><add value="Chat.aspx" /></files>
    </defaultDocument>
    <httpProtocol>
      <customHeaders>
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="DENY" />
        <add name="Referrer-Policy" value="same-origin" />
        <add name="Cache-Control" value="no-store" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
</configuration>
